    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Set zona waktu Jakarta\nconst now = DateTime.now().setZone('Asia/Jakarta');\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  const dateStr = row['Scheduled Date'];\n  const rawTimeStr = row['Scheduled Time'];\n\n  // Pastikan kolom terisi dan status Pending\n  if (row.Status === 'Pending' && dateStr && rawTimeStr) {\n    // Ubah titik (.) pada jam menjadi titik dua (:) jika ada\n    const timeStr = String(rawTimeStr).replace(/\\./g, ':');\n    \n    // Gabungkan tanggal dan waktu\n    const dateTimeString = `${dateStr} ${timeStr}`;\n    \n    // Parse menggunakan Luxon\n    const scheduledTime = DateTime.fromFormat(dateTimeString, 'dd/MM/yyyy H:mm:ss', { zone: 'Asia/Jakarta' });\n\n    // Debugging untuk melihat hasil parsing di log jika masih penasaran\n    console.log(`Parsed: ${dateTimeString} | Valid: ${scheduledTime.isValid}`);\n\n    // Cek validitas dan apakah waktunya sudah tiba\n    if (scheduledTime.isValid && scheduledTime <= now) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;"
      },
